---
import { redes, sitio } from '../utils/sitio.js';


const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container inner">
    <p>© {year} { sitio.nombre }</p>
    <ul>
      {redes.map((r) => (
        <li>
          <a href={r.url} target="_blank" rel="noopener noreferrer">{r.nombre}</a>
        </li>
      ))}
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.9rem;
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    padding-block: 1.5rem;
  }
  p {
    margin: 0;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  a {
    color: var(--muted);
  }
  a:hover {
    color: var(--text);
    text-decoration: none;
  }
</style>