---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { autor, redes } from '../utils/sitio.js';

const posts = await getCollection('blog');

// Etiquetas con su cantidad, de la más usada a la menos usada
const conteo = {};
posts.forEach((p) =>
  p.data.tags.forEach((t) => {
    conteo[t] = (conteo[t] ?? 0) + 1;
  })
);
const etiquetas = Object.entries(conteo).sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0])
);
---

<aside class="sidebar">
  <form class="bento-card" action="/blog" method="get">
    <h3>🔍 Buscar en el blog</h3>
    <div class="search-box">
      <input type="search" name="q" placeholder="Término o etiqueta..." autocomplete="off" />
      <button type="submit">GO</button>
    </div>
  </form>

  <div class="bento-card autor">
    <Image src={autor.avatar} alt={autor.nombre} width={124} height={124} class="avatar-img" />
    <h3>{autor.nombre}</h3>
    <p class="rol">{autor.rol}</p>
    <p class="bio-txt">{autor.bio}</p>
    <a href={autor.enlace.url} target="_blank" rel="noopener noreferrer">{autor.enlace.texto}</a>
  </div>

  {etiquetas.length > 0 && (
    <div class="bento-card">
      <h3>🏷️ Categorías</h3>
      <div class="tags-container">
        {etiquetas.map(([t, n]) => (
          <a class="tag-chip" href={`/blog?etiqueta=${encodeURIComponent(t)}`}>
            #{t} <span>{n}</span>
          </a>
        ))}
      </div>
    </div>
  )}

  <div class="bento-card seguir">
    <h3>📡 Sígueme</h3>
    <ul>
      {redes.map((r) => (
        <li>
          <a href={r.url} target="_blank" rel="noopener noreferrer">
            {r.nombre} <span>↗</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</aside>

<style>
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .bento-card {
    background: var(--surface);
    border-radius: 1rem;
    padding: 1.25rem;
    font-size: 0.85rem;

    box-shadow: 0px 0px 5px  rgba(0, 0, 0, .2);
  }
  .bento-card h3 {
    margin-bottom: 0.75rem;
    font-size: 1.3rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--fg);
  }

  /* Buscador */
  .search-box {
    position: relative;
    display: flex;
    align-items: center;
  }
  .search-box input {
    width: 100%;
    padding: 0.75rem 3.9rem 0.75rem 1rem;
    border: 2px solid var(--border-transparente);
    border-radius: 10px;
    background: var(--bg);
    color: var(--text);
    font-size: 0.9rem;
    transition: border-color 0.25s;
  }
  .search-box input:focus {
    outline: none;
    border-color: var(--accent);
  }
  .search-box button {
    position: absolute;
    right: 0.5rem;
    top: 50%;
    transform: translateY(-50%);
    padding: 0.35rem 0.75rem;
    border: 0;
    border-radius: 8px;
    background: var(--accent);
    color: #111;
    font-weight: 700;
    cursor: pointer;
  }

  /* Autor */
  .autor {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .autor :global(.avatar-img) {
    width: 62px;
    height: 62px;
    margin-bottom: 0.5rem;
    object-fit: cover;
    border-radius: 10px;
    border: 2px solid var(--border-transparente);
  }
  .autor h3 {
    margin: 0;
    font-size: 1.6rem;
    line-height: 1;
    color: var(--text);
  }
  .rol {
    margin: 0.25rem 0 0.75rem;
    font-weight: 700;
    color: var(--fg);
  }
  .bio-txt {
    margin: 0 0 0.5rem;
    color: var(--muted);
  }
  .autor a {
    font-weight: 700;
  }

  /* Categorías */
  .tags-container {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .tag-chip {
    padding: 0.25rem 0.65rem;
    border: 1.5px solid var(--text);
    border-radius: 8px;
    color: var(--text);
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    transition: background 0.25s ease;
  }
  .tag-chip:hover {
    background: var(--accent);
    color: #111;
    text-decoration: none;
    border: 1.5px solid var(--accent);
  }
  .tag-chip span {
    margin-left: 0.2rem;
    opacity: 0.6;
  }

  /* Sígueme */
  .seguir {
    background: var(--accent);
    color: #111;
  }
  .seguir h3 {
    color: #111;
  }
  .seguir ul {
    list-style: none;
  }
  .seguir li + li {
    border-top: 1px solid rgba(0, 0, 0, 0.2);
  }
  .seguir a {
    display: flex;
    justify-content: space-between;
    padding: 0.5rem 0;
    color: #111;
    font-weight: 800;
    transition: padding-left 0.15s;
  }
  .seguir a:hover {
    padding-left: 0.3rem;
    text-decoration: none;
  }
</style>