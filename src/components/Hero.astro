---
import { Image } from 'astro:assets';

// Busca todas las imágenes de la carpeta (si no hay, no falla)
const modules = import.meta.glob('../assets/hero/*.webp', { eager: true });
const images = Object.keys(modules)
  .sort()
  .map((key) => modules[key].default)
  .slice(0, 3);

interface Props {
  title: string;
  subtitle?: string;
}
const { title, subtitle } = Astro.props;
---

<section class="hero">
  <div class="slides" aria-hidden="true">
    {images.map((img, i) => (
      <div class="slide" style={`--i: ${i}`}>
        <Image src={img} alt="" widths={[800, 1400, 1920]} sizes="100vw" loading={i === 0 ? 'eager' : 'lazy'} />
      </div>
    ))}
  </div>
  <div class="overlay"></div>

  <div class="container content">
    <h1>{title}</h1>
    {subtitle && <p>{subtitle}</p>}
    <a class="btn" href="/blog">Ver las entradas →</a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 90vh;
    display: grid;
    align-items: center;
    overflow: hidden;
    color: #fff;
  }
  .slides,
  .overlay {
    position: absolute;
    inset: 0;
  }
  .slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    animation: fade 18s infinite;
    animation-delay: calc(var(--i) * 6s);
  }
  .slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .overlay {
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.45), rgba(0, 0, 0, 0.65));
  }
  .content {
    position: relative;
    padding-block: 4rem;
  }
  h1 {
    font-size: clamp(2rem, 6vw, 3.5rem);
    line-height: 1.1;
    margin: 0 0 1rem;
    max-width: 18ch;
  }
  p {
    font-size: 1.15rem;
    max-width: 50ch;
    margin: 0 0 2rem;
    opacity: 0.9;
  }
  .btn {
    display: inline-block;
    padding: 0.75rem 1.4rem;
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: 999px;
    color: #fff;
    transition: background 0.2s;
  }
  .btn:hover {
    background: rgba(255, 255, 255, 0.15);
    text-decoration: none;
  }

  /* Cada foto se ve ~6s y se cruza con la siguiente */
  @keyframes fade {
    0%   { opacity: 0; }
    6%   { opacity: 1; }
    33%  { opacity: 1; }
    39%  { opacity: 0; }
    100% { opacity: 0; }
  }

  /* Respeta a quien desactiva animaciones */
  @media (prefers-reduced-motion: reduce) {
    .slide { animation: none; }
    .slide:first-child { opacity: 1; }
  }
</style>