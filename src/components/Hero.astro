---
import { Image } from 'astro:assets';

interface Slide {
  image: ImageMetadata;
  title: string;
  tag?: string;
  fecha?: string;
  href?: string;
}
interface Props {
  slides: Slide[];
  esEntrada?: boolean;
}

const { slides, esEntrada = false } = Astro.props;
const Titulo = esEntrada ? 'h1' : 'h2';
---

<section class="hero">
  {slides.map((s, i) => (
    <article class:list={['slide', { activa: i === 0 }]}>
      <Image
        src={s.image}
        alt=""
        widths={[640, 1000, 1400, 1920]}
        sizes="100vw"
        loading={i === 0 ? 'eager' : 'lazy'}
      />
      <div class="velo"></div>
      <div class="texto container">
        {s.tag && <span class="tag">{s.tag}</span>}
        <Titulo>{s.title}</Titulo>
        {s.fecha && <p class="fecha">{s.fecha}</p>}
        {s.href && <a class="boton" href={s.href}>Leer entrada →</a>}
      </div>
    </article>
  ))}

  {slides.length > 1 && (
    <div class="puntos">
      {slides.map((_, i) => (
        <button
          type="button"
          class:list={['punto', { activo: i === 0 }]}
          aria-label={`Ver portada ${i + 1}`}
        ></button>
      ))}
    </div>
  )}
</section>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 480px;
    overflow: hidden;
    background: #000;
    color: #fff;
    border-bottom: 2px solid var(--text);
  }
  .slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.9s;
    pointer-events: none;
  }
  .slide.activa {
    opacity: 1;
    pointer-events: auto;
  }
  .slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .velo {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.85),
      rgba(0, 0, 0, 0.1) 55%,
      rgba(0, 0, 0, 0.25)
    );
  }
  .texto {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding-bottom: 3.5rem;
  }
  .tag {
    display: inline-block;
    padding: 0.1rem 0.5rem;
    background: var(--accent);
    color: #111;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  h1,
  h2 {
    margin: 0.5rem 0;
    max-width: 14ch;
    font-size: clamp(3rem, 11vw, 7rem);
    line-height: 0.9;
    text-transform: uppercase;
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.4);
  }
  .fecha {
    margin: 0;
    opacity: 0.8;
  }
  .boton {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.7rem 1.4rem;
    border: 2px solid #111;
    background: var(--accent);
    color: #111;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    box-shadow: 4px 4px 0 #000;
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .boton:hover {
    text-decoration: none;
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 #000;
  }

  .puntos {
    position: absolute;
    right: 1rem;
    bottom: 1.2rem;
    display: flex;
    gap: 0.5rem;
    z-index: 2;
  }
  .punto {
    width: 12px;
    height: 12px;
    padding: 0;
    border: 2px solid #fff;
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
  }
  .punto.activo {
    background: var(--accent);
    border-color: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .slide {
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll('.hero').forEach((hero) => {
    const slides = hero.querySelectorAll('.slide');
    const puntos = hero.querySelectorAll('.punto');
    if (slides.length < 2) return;

    let actual = 0;
    let timer;

    const mostrar = (n) => {
      slides[actual].classList.remove('activa');
      puntos[actual]?.classList.remove('activo');
      actual = n % slides.length;
      slides[actual].classList.add('activa');
      puntos[actual]?.classList.add('activo');
    };

    const iniciar = () => {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      timer = setInterval(() => mostrar(actual + 1), 6000);
    };

    puntos.forEach((p, i) =>
      p.addEventListener('click', () => {
        clearInterval(timer);
        mostrar(i);
        iniciar();
      })
    );
    hero.addEventListener('mouseenter', () => clearInterval(timer));
    hero.addEventListener('mouseleave', iniciar);

    iniciar();
  });
</script>