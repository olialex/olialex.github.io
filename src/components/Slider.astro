<div class="slider">
  <button class="flecha izq" type="button" aria-label="Anterior">‹</button>
  <div class="pista" tabindex="0">
    <slot />
  </div>
  <button class="flecha der" type="button" aria-label="Siguiente">›</button>
</div>

<style>
  .slider {
    position: relative;
  }
  .pista {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding: 10px 12px 18px 4px;
  }
  .pista::-webkit-scrollbar {
    display: none;
  }
  .pista > :global(*) {
    flex: 0 0 min(65%, 260px);
    scroll-snap-align: start;
  }

  .flecha {
    display: none;
  }
  @media (min-width: 700px) {
    .flecha {
      display: grid;
      place-items: center;
      position: absolute;
      top: 45%;
      width: 40px;
      height: 40px;
      border: 2px solid var(--text);
      border-radius: 50%;
      background: var(--accent);
      color: #111;
      font-size: 1.4rem;
      line-height: 1;
      cursor: pointer;
      z-index: 2;
    }
    .izq { left: -1.2rem; }
    .der { right: -1.2rem; }
  }
</style>

<script>
  document.querySelectorAll('.slider').forEach((s) => {
    const pista = s.querySelector('.pista');
    const mover = (dir) =>
      pista.scrollBy({ left: dir * pista.clientWidth * 0.8, behavior: 'smooth' });
    s.querySelector('.izq').addEventListener('click', () => mover(-1));
    s.querySelector('.der').addEventListener('click', () => mover(1));
  });
</script>