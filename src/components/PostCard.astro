---
import { Image } from 'astro:assets';

interface Props {
  id: string;
  title: string;
  description?: string; // <-- Asegúrate de que esté aquí
  date: Date;
  image?: ImageMetadata | null;
  tags?: string[];
}

// <-- Y asegúrate de extraer 'description' aquí:
const { id, title, description, date, image, tags = [] } = Astro.props;

const fecha = date.toLocaleDateString('es-ES', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});

const limpiar = (s) => s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
const buscar = limpiar([title, description ?? '', ...tags].join(' '));
const etiquetas = tags.map(limpiar).join('|');
---

<a class="portada" href={`/blog/${id}/`} data-buscar={buscar} data-tags={etiquetas}>
  <div class="arte">
    {image ? (
      <Image src={image} alt="" widths={[300, 600]} sizes="(min-width: 700px) 280px, 50vw" />
    ) : (
      <div class="vacio trama"></div>
    )}
  </div>

  <div class="velo"></div>

  <div class="info">
    {tags[0] && <span class="tag">{tags[0]}</span>}
    <h3>{title}</h3>
    <small>{fecha}</small>
  </div>
</a>

<style>
  .portada {
    position: relative;
    display: block;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border: 2px solid var(--text);
    border-radius: 6px;
    background: #000;
    color: #fff;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .portada:hover {
    transform: translate(-3px, -3px);
    box-shadow: 6px 6px 0 var(--accent);
    text-decoration: none;
  }

  .arte {
    position: absolute;
    inset: 0;
  }
  .arte :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .vacio {
    width: 100%;
    height: 100%;
    background-color: var(--accent);
  }

  /* Degradado oscuro + puntos que se desvanecen hacia arriba */
  .velo {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.88), rgba(0, 0, 0, 0) 65%);
  }

  .info {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0.9rem;
  }
  .tag {
    display: inline-block;
    margin-bottom: 0.45rem;
    padding: 0.1rem 0.5rem;
    background: var(--accent);
    color: #111;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  h3 {
    margin: 0;
    font-size: clamp(1.5rem, 6vw, 2rem);
    line-height: 1;
    text-transform: uppercase;
  }
  small {
    display: block;
    margin-top: 0.4rem;
    opacity: 0.8;
    font-size: 0.8rem;
  }
</style>